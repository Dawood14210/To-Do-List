<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brutal_yellow</item>
        <item name="colorPrimaryDark">@color/brutal_ink</item>
        <item name="colorAccent">@color/brutal_yellow</item>
        <item name="android:background">@null</item>
        <!-- Chunky and flat: no window animations, no soft edges. -->
        <item name="android:windowBackground">@color/brutal_cream</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Brand-coloured system bars, overridden at runtime by the
             StatusBar plugin so they follow the in-app theme. -->
        <item name="android:statusBarColor">@color/brutal_yellow</item>
        <item name="android:navigationBarColor">@color/brutal_cream</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>